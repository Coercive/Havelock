{
    "name": "coercive/havelock",
    "type": "library",
    "description": "Coercive Security Havelock",
    "homepage": "http://coercive.fr",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Moral",
            "email": "contact@coercive.fr",
            "homepage": "http://coercive.fr"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-sodium": "*",
        "defuse/php-encryption": "^2.4",
        "coercive/cookie": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "Coercive\\Security\\Havelock\\": "dist/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coercive\\Security\\Havelock\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
